# ============================================================
# PODER JOTA — Plantilla de variables de entorno
# Copia este archivo a .env.local y rellena los valores.
#
# Lo normal es no escribirlos a mano: con el proyecto enlazado,
# `neon deploy` los descarga en .env.local él solo.
# ============================================================

# ---------- Cliente (públicas, se inyectan en el bundle) ----------
# Auth gestionado (Better Auth) del branch de Neon
VITE_NEON_AUTH_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
# Data API (PostgREST) del branch de Neon
VITE_NEON_DATA_API_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/<db>/rest/v1

# ---------- Servidor / migraciones (NUNCA con prefijo VITE_) ----------
# Connection string de Postgres (pooled y directa)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# ---------- Servicios extra de Neon (los rellena `neon deploy`) ----------
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
NEON_DATA_API_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/<db>/rest/v1
NEON_FUNCTION_HELLO_BASE_URL=https://<branch>-hello.compute.<region>.aws.neon.tech/

# Object Storage (bucket "assets")
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
AWS_ENDPOINT_URL_S3=https://<bucket-endpoint>
AWS_REGION=<region>
